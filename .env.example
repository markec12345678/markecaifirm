# Database (local-first, SQLite)
DATABASE_URL="file:./dev.db"

# v6.92: Avtentikacija (obvezno za production)
# Generiraj naključni niz: openssl rand -hex 32
# Pusti PRAZNO za local dev (avtentikacija izklopljena).
# Če je nastavljen, vsi API klici zahtevajo `X-App-Key` header ali `app-key` cookie.
# Frontend (settings UI) naj shrani ta ključ v cookie ob prvem vnosu.
APP_API_KEY=""

# v6.92: SSRF zaščita — dovoli http:// URL-je za outbound webhook/monitor.
# Pusti PRAZNO (default) za HTTPS-only. Nastavi na "1" samo za local dev
# z lokalnimi Bolha/Nepremičnine URL-ji (http://localhost:3000).
ALLOW_HTTP_URLS=""

# AI Provider configuration (alternative to Settings UI)
# Leave empty to use Settings UI values
AI_PROVIDER="ollama"           # ollama | openai | anthropic | openrouter | gemini | openai-compatible
AI_BASE_URL="http://localhost:11434"
AI_API_KEY=""
AI_MODEL="qwen2.5:7b"

# Fallback AI provider (used when primary fails)
FALLBACK_PROVIDER=""
FALLBACK_BASE_URL=""
FALLBACK_API_KEY=""
FALLBACK_MODEL=""

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Discord Webhook (optional)
DISCORD_WEBHOOK_URL=""

# Slack Webhook (optional)
SLACK_WEBHOOK_URL=""

# Email SMTP (optional)
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM=""
EMAIL_TO=""

# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# CAPTCHA solving (optional, for anti-detection)
CAPTCHA_API_KEY_2CAPTCHA=""
CAPTCHA_API_KEY_ANTICAPTCHA=""
CAPTCHA_API_KEY_CAPMONSTER=""

# Proxy (optional, for anti-detection)
PROXY_LIST="[]"                 # JSON array of { url, username?, password?, type: 'http'|'socks5' }

# Next.js
NEXT_TELEMETRY_DISABLED="1"

# v6.92: Telegram webhook secret (preverja ?secret= v URL-ju)
# Generiraj z: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=""

# v6.92: Cron avtentikacija (preverja ?key= v URL-ju za /api/cron/run-all)
# Generiraj z: openssl rand -hex 16
MONITOR_CRON_KEY=""
