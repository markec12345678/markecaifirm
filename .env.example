# Database (local-first, SQLite)
DATABASE_URL="file:./dev.db"

# AI Provider configuration (alternative to Settings UI)
# Leave empty to use Settings UI values
AI_PROVIDER="ollama"           # ollama | openai | anthropic | openrouter | gemini | openai-compatible
AI_BASE_URL="http://localhost:11434"
AI_API_KEY=""
AI_MODEL="qwen2.5:7b"

# Fallback AI provider (used when primary fails)
FALLBACK_PROVIDER=""
FALLBACK_BASE_URL=""
FALLBACK_API_KEY=""
FALLBACK_MODEL=""

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Discord Webhook (optional)
DISCORD_WEBHOOK_URL=""

# Slack Webhook (optional)
SLACK_WEBHOOK_URL=""

# Email SMTP (optional)
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM=""
EMAIL_TO=""

# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# CAPTCHA solving (optional, for anti-detection)
CAPTCHA_API_KEY_2CAPTCHA=""
CAPTCHA_API_KEY_ANTICAPTCHA=""
CAPTCHA_API_KEY_CAPMONSTER=""

# Proxy (optional, for anti-detection)
PROXY_LIST="[]"                 # JSON array of { url, username?, password?, type: 'http'|'socks5' }

# Next.js
NEXT_TELEMETRY_DISABLED="1"
