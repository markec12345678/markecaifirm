# ============================================================================
# Markec AI Firm — Environment Variables
# ============================================================================
# This file documents ALL environment variables the project understands.
#
# ⚠️ IMPORTANT: Most configuration is NOT read from .env at runtime!
#
# The code reads ONLY these 7 env vars directly (see grep process.env in src/):
#   DATABASE_URL, APP_API_KEY, ALLOW_HTTP_URLS, MONITOR_CRON_KEY,
#   TELEGRAM_WEBHOOK_SECRET, NEXT_PUBLIC_APP_URL, NODE_ENV (auto by Next.js)
#
# All other config (AI provider, Telegram, Discord, Slack, Email, VAPID,
# CAPTCHA, Proxy) is stored in the SQLite `Settings` table and managed via
# the Settings UI at http://localhost:3000 → NASTAVITVE tab.
#
# The AI_*, TELEGRAM_*, DISCORD_*, SLACK_*, EMAIL_*, VAPID_*, CAPTCHA_*,
# PROXY_LIST, FALLBACK_* vars below are kept for reference / documentation
# only — the code does NOT read them. To actually configure these features,
# use the Settings UI.
# ============================================================================

# ─── READ BY CODE ───────────────────────────────────────────────────────────

# Database (local-first, SQLite) — REQUIRED
DATABASE_URL="file:./dev.db"

# v6.92: Authentication — required for production
# Generate: openssl rand -hex 32
# Leave EMPTY for local dev (authentication disabled).
# When set, all API calls require `X-App-Key` header or `app-key` cookie.
APP_API_KEY=""

# v6.92: SSRF protection — allow http:// URLs for outbound webhook/monitor.
# Leave EMPTY (default) for HTTPS-only. Set to "1" only for local dev.
ALLOW_HTTP_URLS=""

# v7.32: Public app URL — used for self-referencing webhooks/callbacks.
# Replace with your production domain when deploying.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Next.js telemetry — disable in dev
NEXT_TELEMETRY_DISABLED="1"

# v6.92: Telegram webhook secret (checks ?secret= in URL)
# Generate: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=""

# v6.92: Cron authentication (checks ?key= in URL for /api/cron/run-all)
# Generate: openssl rand -hex 16
MONITOR_CRON_KEY=""

# ─── NOT READ BY CODE — configure via Settings UI instead ───────────────────
# The variables below are documented for reference. The code reads the
# equivalent values from the `Settings` table (managed via NASTAVITVE tab).

# AI Provider — configure at /settings → AI Provider
# AI_PROVIDER="ollama"           # ollama | openai | anthropic | openrouter | gemini | openai-compatible
# AI_BASE_URL="http://localhost:11434"
# AI_API_KEY=""
# AI_MODEL="qwen2.5:7b"

# Fallback AI provider — configure at /settings → AI Provider
# FALLBACK_PROVIDER=""
# FALLBACK_BASE_URL=""
# FALLBACK_API_KEY=""
# FALLBACK_MODEL=""

# Telegram Bot — configure at /settings → Notifications
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# Discord Webhook — configure at /settings → Notifications
# DISCORD_WEBHOOK_URL=""

# Slack Webhook — configure at /settings → Notifications
# SLACK_WEBHOOK_URL=""

# Email SMTP — configure at /settings → Notifications
# EMAIL_SMTP_HOST=""
# EMAIL_SMTP_PORT="587"
# EMAIL_SMTP_USER=""
# EMAIL_SMTP_PASSWORD=""
# EMAIL_FROM=""
# EMAIL_TO=""

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# CAPTCHA solving — configure at /settings → Anti-Detection
# CAPTCHA_API_KEY_2CAPTCHA=""
# CAPTCHA_API_KEY_ANTICAPTCHA=""
# CAPTCHA_API_KEY_CAPMONSTER=""

# Proxy list — configure at /settings → Anti-Detection
# JSON array of { url, username?, password?, type: 'http'|'socks5' }
# PROXY_LIST="[]"
