// Prisma schema for Markec AI Firm — Opportunity Monitor

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// v4.9: Profile — switchable profiles for different scenarios (e.g., "Avto", "Nepremicnine", "Test")
// Settings has activeProfileId field; Monitor and Trade have optional profileId
// When activeProfileId is null, all data is shown (default behavior)
model Profile {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  color       String   @default("primary") // tailwind color name for badge
  icon        String   @default("📁") // emoji
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  monitors    Monitor[]
  trades      Trade[]
  settings    Settings?
}

// Single-row table storing app configuration (AI provider, Telegram, etc.)
model Settings {
  id              String   @id @default("singleton")
  // AI provider config
  aiProvider      String   @default("ollama") // ollama | openai | anthropic | openai-compatible | openrouter | gemini
  aiBaseUrl       String   @default("http://localhost:11434")
  aiApiKey        String   @default("")
  aiModel         String   @default("qwen2.5:7b")
  // v2.6: AI fallback — when primary provider fails, use fallback
  fallbackProvider String  @default("") // empty = disabled
  fallbackBaseUrl  String  @default("")
  fallbackApiKey   String  @default("")
  fallbackModel    String  @default("")
  // Telegram config
  telegramBotToken String  @default("")
  telegramChatId   String  @default("")
  telegramEnabled  Boolean @default(false)
  // v1.4: Discord webhook
  discordWebhookUrl String @default("")
  discordEnabled   Boolean @default(false)
  // v2.1: Slack webhook
  slackWebhookUrl  String  @default("")
  slackEnabled     Boolean  @default(false)
  // v2.7: Email notifications (SMTP)
  emailEnabled     Boolean  @default(false)
  emailSmtpHost    String  @default("")
  emailSmtpPort    Int     @default(587)
  emailSmtpUser    String  @default("")
  emailSmtpPassword String  @default("")
  emailFrom        String  @default("")
  emailTo          String  @default("")
  // Heartbeat
  heartbeatEnabled Boolean @default(true)
  heartbeatHour    Int     @default(22) // 22:00 local
  lastHeartbeatAt  DateTime?
  // Thresholds
  minOpportunityScore Int  @default(7)   // 1-10 — alert only when AI score >= this
  maxRiskScore        Int  @default(3)   // 1-10 — alert only when AI risk <= this
  // v8.24: User Risk Profile — makes Master Brain personal
  userRiskTolerance     String   @default("balanced") // 'conservative' | 'balanced' | 'aggressive'
  userMaxAcceptableRisk Int      @default(50) // 0-100 — max risk score user will accept
  userLiquidityReserve  Float    @default(500) // EUR — minimum cash reserve to keep
  userInvestmentHorizon String   @default("medium") // 'short' | 'medium' | 'long'
  // Image analysis (v1.1)
  imageAnalysisEnabled Boolean @default(false)
  // Bolha Playwright fallback (v1.1)
  playwrightEnabled    Boolean @default(false)
  // Telegram inline buttons (v1.1)
  telegramInlineButtons Boolean @default(true)
  // Webhook secret for Telegram callback queries (v1.1)
  telegramWebhookSecret String @default("")
  // v1.5: Web Push notifications (VAPID)
  pushEnabled          Boolean @default(false)
  vapidPublicKey       String  @default("")
  vapidPrivateKey      String  @default("")
  // v1.6: Digest mode (namesto instant alerts)
  digestMode           String  @default("instant") // instant | daily | weekly
  digestHour           Int     @default(20) // 20:00 local
  // v1.6: Quick response templates (JSON array of {name, text} objects)
  quickResponseTemplates String @default("[]")
  // v2.2: Notification quiet hours — don't send alerts during these hours
  quietHoursEnabled    Boolean @default(false)
  quietStartHour       Int     @default(22) // 22:00
  quietEndHour         Int     @default(7)  // 07:00
  // v2.2: Auto-cleanup — automatically archive/delete old data
  autoCleanupEnabled   Boolean @default(false)
  autoCleanupAlertsDays Int    @default(30) // archive alerts older than N days
  autoCleanupListingsDays Int  @default(90) // delete listings older than N days
  // v3.2: AI usage tracking
  aiCallsToday         Int    @default(0)
  aiCallsDate          String @default("") // YYYY-MM-DD for daily reset
  // v4.2: Profit goal tracking
  monthlyProfitGoal    Float  @default(0)  // EUR per month, 0 = disabled
  // v8.50: First-Run Onboarding
  onboardingCompleted  Boolean @default(false) // true after user completes onboarding wizard
  // v5.5: Category-based notification preferences (JSON: { "avto": {telegram: false, push: true}, ... })
  categoryNotifications String @default("{}")
  // v5.6: Dashboard widget layout (JSON array of widget IDs in display order)
  dashboardLayout      String @default("[]")
  // v5.8: Advanced scraping config
  // Proxy: JSON array of { url, username?, password?, type: 'http'|'socks5' }
  proxyList            String @default("[]")
  proxyEnabled         Boolean @default(false)
  // Realistic headers: rotate User-Agent strings
  realisticHeaders     Boolean @default(true)
  // Request randomization: random delay between requests (ms)
  requestMinDelay      Int    @default(1000) // min delay between requests
  requestMaxDelay      Int    @default(5000) // max delay
  // Stealth mode: use Playwright with anti-detection
  stealthMode          Boolean @default(false)
  // CAPTCHA solving: 2captcha API key
  captchaSolverEnabled Boolean @default(false)
  captchaApiKey        String @default("") // primary provider key
  // v5.9: Multi-provider CAPTCHA support
  captchaProvider      String @default("2captcha") // 2captcha | anti-captcha | capmonster | custom
  captchaApiKeyAnticaptcha String @default("")
  captchaApiKeyCapmonster  String @default("")
  captchaCustomApiUrl      String @default("") // for custom provider
  // TLS fingerprinting: use custom TLS client
  tlsFingerprinting    Boolean @default(false)
  // v4.9: Active profile (null = show all data, no profile filter)
  activeProfileId      String? @unique
  activeProfile        Profile? @relation(fields: [activeProfileId], references: [id], onDelete: SetNull)
  // v6.1: Email digest template (HTML template with {{title}}, {{listings}}, etc.)
  emailDigestTemplate  String @default("")
  // v8.28: Adaptive Domain Weights — JSON storing per-domain weight + execution stats.
  // Format: {"profit":{"weight":1.2,"executed":0,"rejected":0,"lastAdjustedAt":null,"adjustmentHistory":[]},...}
  // When null, Master Brain uses DEFAULT_DOMAIN_WEIGHTS (hardcoded in master.ts).
  // Updated by recordActionFeedback() after every user "executed"/"rejected" mark.
  // Re-evaluated every 10 actions per domain: executionRate > 0.8 → ×1.1 (boost),
  // < 0.4 → ×0.9 (reduce), clamp [0.5, 2.0]. Stored per-user (singleton row).
  adaptiveDomainWeights String?
  // v8.30: Safe Auto-pilot configuration — Automation phase.
  // Master switch (autoPilotEnabled) gates the whole subsystem. When true, an
  // hourly cron (and manual trigger) checks pending ActionDraft rows and
  // auto-executes those that meet ALL 8 safety rules (see auto-pilot.ts).
  // Mode 'safe' = LOW-risk only (confidence=LOW, uplift<100€, domain!=risk).
  // Mode 'aggressive' is reserved for v8.31 (not yet implemented — kept for
  // forward-compat so config can be persisted now).
  // Daily limit + budget cap prevent runaway auto-execution.
  autoPilotEnabled       Boolean  @default(false) // master switch — default OFF
  autoPilotMode          String   @default("safe") // 'safe' | 'aggressive' (v8.31)
  autoPilotDailyLimit    Int      @default(5)    // max auto-executions per day
  autoPilotDailyBudgetEUR Float   @default(500)   // max total expectedUpliftEUR per day
  autoPilotLastRunAt     DateTime?              // last time auto-pilot ran (cron or manual)
  // v8.31: Aggressive Auto-pilot + Anomaly detection — AUTOMATION PHASE COMPLETE.
  // Aggressive mode (opt-in, double confirmation): allows MEDIUM confidence too
  // (HIGH always manual in BOTH modes), higher limits (10/day, 2000€/day),
  // uplift < 300€. Domain != 'risk' still enforced in both modes.
  // Anomaly detection: if >8 auto-executions in 1 hour → suspend auto-pilot
  // (possible loop), requires manual re-enable via clearAnomalySuspension().
  autoPilotAggressiveConfirmedAt DateTime?  // when user double-confirmed aggressive mode
  autoPilotAnomalySuspended      Boolean   @default(false)  // true if anomaly detection suspended auto-pilot
  autoPilotAnomalySuspendedAt     DateTime?  // when anomaly was triggered
  autoPilotAnomalyReason         String?    // why suspended (e.g. "8 akcij v 1 uri — possible loop")
  autoPilotHourlyExecCount       Int       @default(0)  // count of executions in current hour window
  autoPilotHourlyWindowStart     DateTime?  // start of current 1-hour window
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// v6.1: Saved Searches — uporabnik shrani kompleksne iskalne filtrore
model SavedSearch {
  id          String   @id @default(cuid())
  name        String
  // JSON: { monitorId, verdict, minScore, maxRisk, hasImage, bookmarkedOnly, contactFilter, sort, keywords }
  filters     String
  // Optional: auto-run and notify when new results
  autoNotify  Boolean  @default(false)
  lastRunAt   DateTime?
  lastResultCount Int  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// v1.5: Push subscription — stores browser push endpoints
model PushSubscription {
  id          String   @id @default(cuid())
  endpoint    String   @unique // browser push endpoint URL
  p256dh      String   // user agent public key
  auth        String   // auth secret
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// v1.6: Trade — tracks bought + sold listings for profit calculation
model Trade {
  id          String   @id @default(cuid())
  // v4.9: Profile assignment (null = no profile / visible in all)
  profileId   String?
  profile     Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  // Link to original listing (nullable if user manually adds)
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // Item details (denormalized so manual trades work without listing)
  title       String
  category    String   @default("") // npr. "elektronika", "avto", "nepremičnina"
  imageUrl    String?
  url         String?
  // Buy side
  buyPrice    Float    // EUR
  buyDate     DateTime @default(now())
  buyLocation String   @default("") // kje kupljeno (Bolha, FB, trgovina)
  buyFees     Float    @default(0) // pristojbine, šhiping pri nakupu
  // Sell side (null if not yet sold)
  sellPrice   Float?
  sellDate    DateTime?
  sellLocation String  @default("") // kje prodano
  sellFees    Float    @default(0) // pristojbine pri prodaji
  // Status
  status      String   @default("held") // held | sold | cancelled
  // Notes
  notes       String   @default("")
  // v7.35: Flip Workflow checklist — JSON array of {step, completedAt}
  // Steps: received, cleaned, photographed, described, listed_bolha, listed_vinted, listed_other, price_review_7d, price_drop_14d, price_drop_30d
  flipChecklist String @default("[]")
  // v8.63: User-defined tags (comma-separated, e.g. "flip,premium,restock")
  // Enables flexible semantic categorization beyond fixed category/source
  tags        String   @default("")
  // v8.69: Buy Opportunity Score context (persisted from listing at buy time)
  // Enables post-sale outcome analysis (v8.67) with original buy intelligence
  buyScore       Int?      // 0-100 — buy opportunity score at time of purchase
  buyVerdict     String?   // STRONG_BUY | BUY | CONSIDER | AVOID
  buyScoreAt     DateTime? // when the buy score was computed (for staleness check)
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, buyDate])
  @@index([category])
  // v7.32: Missing indexes for common queries
  @@index([sellDate])
  @@index([sellLocation])
  @@index([profileId])
}

// v8.71: Buy Request — saved item search criteria.
// "I'm looking for VW Golf 5, 2020, max 15000€, Ljubljana" → saved + reusable.
// Optional searchFor = person name for proxy buying (gift shopping, searching for someone).
model BuyRequest {
  id          String   @id @default(cuid())
  // Who is this search for? (empty = for self)
  searchFor   String   @default("") // e.g., "Marko", "Mama", "Kolega" — proxy buying
  // Search criteria
  title       String   // item name (e.g., "VW Golf 5")
  keywords    String   @default("") // additional keywords (comma-separated)
  category    String   @default("") // elektronika/avto/oblačila/...
  priceMin    Int?
  priceMax    Int?
  location    String   @default("") // city/region filter
  yearMin     Int?     // for cars/electronics with model year
  yearMax     Int?
  condition   String   @default("") // novo | rabljeno | ''
  // Sort preference
  sortBy      String   @default("cheapest") // cheapest | best_score | newest | closest
  // Metadata
  notes       String   @default("")
  isActive    Boolean  @default(true)
  lastRunAt   DateTime? // v8.75: when the auto-monitor last ran this search
  newMatchesCount Int @default(0) // v8.75: unread new matches since last view
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profileId   String?
  // v8.75: Matches found by auto-monitor
  matches     BuyRequestMatch[]

  @@index([isActive])
  @@index([category])
  @@index([searchFor])
}

// v8.75: BuyRequestMatch — tracks which listings matched a BuyRequest (for dedup)
model BuyRequestMatch {
  id            String   @id @default(cuid())
  buyRequestId  String
  buyRequest    BuyRequest @relation(fields: [buyRequestId], references: [id], onDelete: Cascade)
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Snapshot of match data at time of discovery
  matchPrice    Int?     // listing price when matched
  matchBuyScore Int?     // buy score when matched
  isNotified    Boolean  @default(false) // was user notified about this match?
  isRead        Boolean  @default(false) // has user seen this match?
  matchedAt     DateTime @default(now())

  @@unique([buyRequestId, listingId]) // dedup — one match per listing per request
  @@index([buyRequestId, isRead])
  @@index([matchedAt])
}

// v1.6: Digest log — when digests were sent (for scheduling)
model DigestLog {
  id          String   @id @default(cuid())
  sentAt      DateTime @default(now())
  type        String   // daily | weekly
  listingsCount Int    @default(0)
  alertsCount Int      @default(0)
  topOpportunities Int @default(0)
  sentTelegram Boolean @default(false)
  sentDiscord  Boolean @default(false)
  sentPush     Boolean @default(false)
  message     String
}

// A configured search monitor (e.g. "iPhone 13 Pro on Bolha", "2-sobno LJ na Nepremicnine")
model Monitor {
  id          String   @id @default(cuid())
  name        String
  source      String   // bolha | nepremicnine | avtonet | salomon | custom-rss | vinted | mobile-de | kleinanzeigen | subito | willhaben
  sourceUrl   String   // the search URL or RSS URL
  // v4.9: Profile assignment (null = no profile / visible in all)
  profileId   String?
  profile     Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  // Optional filters
  keywords    String   @default("") // comma-separated, must appear in title/description
  excludeKeywords String @default("")
  minPrice    Int?
  maxPrice    Int?
  // Schedule
  intervalMinutes Int @default(30)
  isActive   Boolean  @default(true)
  // v1.2: schedule window — only run during these hours (e.g. "6-23"). Empty = always.
  runStartHour Int?
  runEndHour   Int?
  lastRunAt  DateTime?
  lastStatus String?  // ok | error | empty
  lastError  String?
  // v1.3: auto-pause after N consecutive errors
  consecutiveErrors Int @default(0)
  autoPauseThreshold Int @default(5)  // 0 = disabled, otherwise pause after N consecutive errors
  autoPausedAt DateTime?
  // v2.2: Monitor-specific notification channels (JSON: {telegram, discord, slack, push})
  notificationChannels String @default("{}") // empty = use global settings
  // AI prompt customization (optional)
  customPrompt String @default("")
  // v4.4: Tags for grouping/filtering (comma-separated, e.g. "avto,ljubljana,investicija")
  tags String @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listings   Listing[]
  alerts     Alert[]
  runLogs    RunLog[]
  scraperStatuses ScraperStatus[] // v9.57: real-time scraper tracking
  // v7.32: Missing indexes
  @@index([isActive])
  @@index([profileId])
}

// A scraped listing — kept for deduplication & history
model Listing {
  id          String   @id @default(cuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  externalId  String   // unique listing id from source (URL hash)
  title       String
  price       Int?     // EUR
  priceText   String   // raw price text (e.g. "Po dogovoru")
  url         String
  location    String   @default("")
  description String   @default("")
  imageUrl    String?
  postedAt    DateTime?
  firstSeenAt DateTime @default(now())
  // AI evaluation (cached)
  aiScore        Int?      // 1-10 opportunity score
  aiRisk         Int?      // 1-10 risk score
  aiVerdict      String?   // PRILIKA | SUMNJIVO | NEZANIMIVO
  aiReason       String?
  aiEstimatedValue Int?    // EUR — what AI thinks fair market value is
  aiEvaluatedAt  DateTime?
  // Image analysis (v1.1)
  aiImageAnalysis String?  // AI description of the listing image
  aiImageVerdict  String?  // AUTHENTIC | SUSPICIOUS | STOCK_PHOTO | NO_IMAGE
  // v2.4: bookmark/favorite
  isBookmarked    Boolean  @default(false)
  bookmarkedAt    DateTime?
  // v4.1: Hidden (hide without delete)
  isHidden        Boolean  @default(false)
  hiddenAt        DateTime?
  // v1.4: full detail page data (Bolha detail page scraper)
  detailDescription String? // full description from detail page (longer than listing description)
  detailImages      String? // JSON array of all image URLs
  detailFetchedAt   DateTime?
  // v2.0: seller tracking (extracted from listing URL or description)
  sellerName       String?
  sellerListingCount Int   @default(0) // how many listings this seller has
  // v2.0: price drop tracking
  previousPrice    Int?    // last known price before current (for drop detection)
  priceDroppedAt   DateTime? // when the price last dropped
  // v2.4: Personal notes (user's own notes about this listing)
  userNotes        String?
  userNotesUpdatedAt DateTime?
  // v2.4: Contact tracking
  contactStatus    String   @default("none") // none | contacted | responded | closed
  contactedAt      DateTime?
  sellerResponse   String?
  // v4.4: AI Deal Score 0-100 (separate from aiScore 1-10)
  dealScore        Int?     // 0-100, higher = better deal
  dealScoreReason  String?  // short AI explanation
  dealScoreComputedAt DateTime?
  // v4.5: User-defined target price — alert me when price drops at or below this
  targetPrice      Int?     // EUR — alert when price <= this
  targetPriceSetAt DateTime?
  targetPriceAlertSent Boolean @default(false) // prevent alert spam
  // Alerts generated for this listing
  alerts      Alert[]
  priceHistory PriceHistory[]
  // v1.6: Trade (if this listing was bought)
  trades      Trade[]
  // v5.4: Negotiation messages with seller
  negotiationMessages NegotiationMessage[]
  // v8.75: BuyRequest matches (when this listing matched a saved search)
  buyRequestMatches BuyRequestMatch[]

  @@unique([monitorId, externalId])
  @@index([monitorId, firstSeenAt])
  @@index([aiVerdict, aiScore])
  @@index([isBookmarked, firstSeenAt])
  @@index([isHidden, firstSeenAt])
  @@index([price])
  @@index([sellerName])
  // v7.32: Missing indexes
  @@index([contactStatus])
  @@index([dealScore])
  @@index([targetPrice])
  @@index([priceDroppedAt])
}

// An alert that was sent (Telegram/email/dashboard)
model Alert {
  id          String   @id @default(cuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  title       String
  body        String
  url         String
  aiScore     Int?
  aiRisk      Int?
  aiVerdict   String?
  // Delivery
  sentTelegram Boolean @default(false)
  telegramSentAt DateTime?
  telegramError String?
  // v2.9: Notification delivery tracking
  sentDiscord   Boolean @default(false)
  discordError  String?
  sentSlack     Boolean @default(false)
  slackError    String?
  sentEmail     Boolean @default(false)
  emailError    String?
  sentPush      Boolean @default(false)
  pushError     String?
  // UI state
  isRead      Boolean  @default(false)
  isArchived  Boolean  @default(false)
  // v1.2: user feedback for AI accuracy tracking
  userAction  String?  // interested | archived | scam | ignored (auto-set after 7 days)
  userActionedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([monitorId, createdAt])
  @@index([isArchived, createdAt])
  @@index([userAction])
  // v7.32: Missing indexes
  @@index([isRead, createdAt])
  @@index([aiVerdict])
}

// Run log — every monitor execution record
model RunLog {
  id          String   @id @default(cuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  status      String   // ok | error | empty
  listingsFound Int    @default(0)
  newListings  Int     @default(0)
  alertsSent   Int     @default(0)
  error       String?
  durationMs  Int?

  @@index([monitorId, startedAt])
  // v7.32: Missing index
  @@index([status])
}

// v9.57: ScraperStatus — real-time tracking of scraping activity + block detection + bypass attempts
model ScraperStatus {
  id            String   @id @default(cuid())
  monitorId     String?
  monitor       Monitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  // What URL/source is being scraped right now
  source        String   // bolha | vinted | avtonet | mobile-de | etc
  targetUrl     String   // the search URL being scraped
  status        String   @default("idle") // idle | running | blocked | bypassed | error | success
  // When did scraping start
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  // Block detection details
  blockType     String? // captcha | cloudflare | 403 | 429 | timeout | ip-ban | empty-response
  blockDetails  String? // JSON: { statusCode, headers, body snippet }
  // Bypass attempts
  bypassAttempts Int     @default(0)
  bypassMethod  String? // proxy-rotation | captcha-solve | stealth-mode | retry-backoff | playwright
  bypassSuccess Boolean  @default(false)
  // Stats from this scrape
  listingsFound Int      @default(0)
  newListings   Int      @default(0)
  // Error (if status=error)
  error         String?

  @@index([monitorId, startedAt])
  @@index([status])
  @@index([source])
}

// v9.62: CopilotSuggestion — Decision Learning Loop tracking.
// Vsak AI predlog gre skozi lifecycle:
//   pending → approved/rejected → executed → outcome_recorded
//
// To omogoča Decision Accuracy metric:
// "Od zadnjih 500 Copilot priporočil je bilo 73% pravilnih."
model CopilotSuggestion {
  id              String   @id @default(cuid())
  // Suggestion metadata
  type            String   // buy | sell | stop-monitor | restock | investigate
  priority        String   // high | medium | low
  title           String
  description     String
  reason          String   @default("")
  expectedOutcome String  @default("")
  riskLevel       String   @default("medium") // low | medium | high
  category        String   @default("opportunity") // opportunity | warning | optimization | investigation
  icon            String   @default("💡")
  actionData      String   @default("{}") // JSON: { listingId, tradeId, monitorId, url, suggestedPrice, ... }
  autoExecutable  Boolean  @default(false)
  // Lifecycle status
  // pending = čaka na uporabnikovo odločitev
  // approved = uporabnik je potrdil predlog (še ni izvedeno)
  // rejected = uporabnik je zavrnil predlog
  // executed = akcija je bila dejansko izvedena (trade dodan, monitor ustavljen, etc.)
  // outcome_recorded = izid je bil zabeležen (profit/loss znan)
  // expired = predlog je potekel brez odziva
  status          String   @default("pending")
  approvedAt      DateTime?
  rejectedAt      DateTime?
  executedAt      DateTime?
  outcomeRecordedAt DateTime?
  // Outcome tracking (samo za approved+executed)
  outcome         String?  // profit | loss | neutral | null (if not yet known)
  profitAmount    Float?   // actual profit/loss in EUR (null if not yet known) — legacy field
  wasCorrect      Boolean? // was the AI recommendation correct? (true if outcome matched expectation)
  // v9.63: Richer metrics for Decision Learning Loop
  expectedProfit  Float?   // AI predicted profit in EUR (at suggestion time)
  expectedRoi     Float?   // AI predicted ROI % (at suggestion time)
  actualProfit    Float?   // actual profit/loss in EUR (when outcome recorded)
  actualRoi       Float?   // actual ROI % (when outcome recorded)
  confidenceAtSuggestion Int?  // AI confidence 0-100 at suggestion time
  timeToOutcomeDays Int?   // days from executedAt to outcomeRecordedAt
  wasCorrectReason String? // human-readable explanation why correct/incorrect
  wasCorrectRule  String?  // which rule was used: "profit_positive" | "roi_match" | "sold_within_window" | etc.
  // User feedback
  feedback        String?  // optional user feedback on reject
  // Relations
  relatedTradeId   String?  // link to Trade if became a trade
  relatedListingId String?  // link to Listing for buy suggestions
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
  @@index([wasCorrect])
}

// Heartbeat log — daily system health report (v1.1)
model HeartbeatLog {
  id            String   @id @default(cuid())
  sentAt        DateTime @default(now())
  periodStart   DateTime
  periodEnd     DateTime
  totalRuns     Int      @default(0)
  successfulRuns Int     @default(0)
  failedRuns    Int      @default(0)
  totalListings Int      @default(0)
  newListings   Int      @default(0)
  totalAlerts   Int      @default(0)
  prilikaAlerts Int      @default(0)
  sumnjivoAlerts Int     @default(0)
  activeMonitors Int     @default(0)
  sentTelegram  Boolean  @default(false)
  telegramError String?
  message       String
}

// v1.4: Price history — tracks price changes of a listing over time
model PriceHistory {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price       Int?     // EUR — null if "po dogovoru"
  priceText   String   // raw text
  seenAt      DateTime @default(now())

  @@index([listingId, seenAt])
}

// v5.3: Smart Rules — kompleksna pravila za alerte (npr. "alert ko 3 podobni oglasi padejo pod X€")
model SmartRule {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  // Rule type: 'price_threshold' | 'multiple_listings' | 'price_drop_pct' | 'ai_verdict_combo' | 'time_based'
  ruleType    String
  // JSON configuration for the rule (depends on ruleType)
  // price_threshold: { monitorId, priceBelow, minDealScore? }
  // multiple_listings: { monitorId, count, withinHours, priceBelow? }
  // price_drop_pct: { monitorId, dropPct, withinHours }
  // ai_verdict_combo: { monitorId, minAiScore, maxAiRisk, minDealScore? }
  // time_based: { monitorId, hoursOld, priceBelow? }
  config      String   // JSON
  // Channels (JSON array: ['telegram', 'discord', 'slack', 'push', 'email'])
  channels    String   @default("[]")
  isActive    Boolean  @default(true)
  // Tracking
  lastTriggeredAt DateTime?
  triggerCount Int     @default(0)
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// v5.4: Negotiation messages — sledi pogajanjem z vsakim prodajalcem
model NegotiationMessage {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Message direction: 'sent' (from user to seller) | 'received' (from seller to user)
  direction   String
  // Message content
  text        String
  // AI generated?
  isAiGenerated Boolean @default(false)
  // AI suggested next step (filled when message is sent)
  aiNextStep  String?
  // Negotiation status: 'initial' | 'offer_sent' | 'counter_received' | 'accepted' | 'declined' | 'no_response'
  status      String   @default("initial")
  // Suggested price in this message (if applicable)
  suggestedPrice Int?
  // Metadata
  createdAt   DateTime @default(now())

  @@index([listingId, createdAt])
}

// v5.4: Webhook endpoints — zunanji servisi (Zapier, Make) prejemajo alerte
model WebhookEndpoint {
  id          String   @id @default(cuid())
  name        String
  url         String
  // Secret for HMAC signature verification
  secret      String   @default("")
  // Events to subscribe to (JSON array: ['alert.created', 'price.drop', 'target.hit', 'listing.new'])
  events      String   @default("[]")
  // Active?
  isActive    Boolean  @default(true)
  // Tracking
  lastTriggeredAt DateTime?
  lastResponseStatus Int?
  lastError   String?
  triggerCount Int     @default(0)
  failCount   Int      @default(0)
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// v8.29: Action Draft Queue — stores Master Brain TOP 5 actions with execution status.
// Closed feedback loop: Master Brain recommends → user approves/rejects → adaptive weights learn.
// Each row represents ONE recommended action from the Master Brain banner. When the user
// clicks ✅ Izvedel or ❌ Zavrnil in the UI, the draft's status is updated AND
// recordActionFeedback() (from v8.28 adaptive-weights.ts) is called — closing the loop.
//
// Lifecycle:
//   1. Master Brain banner fetches /api/ai/brain/drafts (POST) → creates 5 drafts (status='pending')
//   2. Existing 'pending' drafts are marked 'expired' (replaced by new recommendations)
//   3. User clicks ✅ → status='executed' + executedAt set + recordActionFeedback('executed')
//   4. User clicks ❌ → status='rejected' + rejectedAt set + recordActionFeedback('rejected')
//   5. Cron cleanup deletes drafts older than 90 days that are 'executed'/'rejected'/'expired'
model ActionDraft {
  id              String   @id @default(cuid())
  // Master Brain action data (denormalized for history)
  rank            Int                   // 1-5 (rank in TOP 5 when created)
  domain          String                 // 'profit'|'inventory'|'market'|'sourcing'|'risk'|'buyer'|'pricing'
  signal          String                 // signal name within domain
  action          String                 // human-readable action text
  expectedUpliftEUR Float               // EUR/month expected uplift
  confidence     String                 // 'HIGH'|'MEDIUM'|'LOW'
  // Status tracking
  status         String   @default("pending") // 'pending'|'approved'|'executed'|'rejected'|'expired'
  // User feedback (filled when status changes to executed/rejected)
  feedbackNote   String?               // optional user note
  executedAt     DateTime?             // when user marked as executed
  rejectedAt     DateTime?             // when user marked as rejected
  // Link to Master Brain snapshot (if created from one)
  snapshotDate   String?               // YYYY-MM-DD of the BrainSnapshot that generated this
  // v8.30: Safe Auto-pilot tracking — Automation phase.
  // autoExecuted=true marks that the action was auto-executed by the auto-pilot
  // (vs a manual ✅ Izvedel click). autoPilotReason stores the audit trail of
  // which 8 safety rules passed (semicolon-separated). rolledBack=true marks
  // that the user subsequently undid the auto-execution (calls
  // recordActionFeedback with 'rejected' to undo the learning). The action
  // itself is NOT un-executed in the real world (we can't un-send a Telegram
  // message), but the audit + undo-learning is preserved for review.
  autoExecuted     Boolean  @default(false)  // true if auto-pilot executed this (vs manual)
  autoPilotReason  String?                  // why auto-pilot executed/rejected this (audit log)
  rolledBack       Boolean  @default(false)  // true if user rolled back this execution
  rolledBackAt     DateTime?                // when user rolled back
  rollbackReason   String?                  // why user rolled back
  // Metadata
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([domain])
  @@index([createdAt])
  // v8.30: indexes for auto-pilot queries — find auto-executed drafts for
  // today's stats, find rollback candidates, find eligible pending drafts.
  @@index([autoExecuted])
  @@index([rolledBack])
}

// v8.23: Daily Brain Snapshot — stores Master Brain output for historical accuracy tracking.
// Cron job @ 00:00 calls masterBrain() and saves the full result here.
// Used by v8.25 (Historical Accuracy) to compare predicted vs actual profit.
model BrainSnapshot {
  id              String   @id @default(cuid())
  date            String   // YYYY-MM-DD (unique per day)
  // Overall Master Brain summary (lightweight fields for quick queries)
  overallHealth   Float    // 0-100
  healthGrade     String   @default("C") // 'A+'|'A'|'B'|'C'|'D'|'F'
  riskLevel       String   @default("MEDIUM") // 'LOW'|'MEDIUM'|'HIGH'|'CRITICAL'
  topActionCount  Int      @default(5)
  conflictCount   Int      @default(0)
  bottleneckCount Int      @default(0)
  strengthCount   Int      @default(0)
  // Strategy projections (EUR)
  projection30dEUR  Float  @default(0)
  projection90dEUR  Float  @default(0)
  projection12mEUR  Float  @default(0)
  // 7 Domain grades (for trend analysis)
  profitGrade     String   @default("C")
  inventoryGrade  String   @default("C")
  marketGrade     String   @default("C")
  sourcingGrade   String   @default("C")
  riskGrade       String   @default("C")
  buyerGrade      String   @default("C")
  pricingGrade    String   @default("C")
  // Full Master Brain JSON (for deep drill-down)
  masterResultJson String  // full JSON.stringify(masterResult)
  // Actual profit at time of snapshot (filled by v8.25 backfill, null at creation)
  actualProfit30d  Float?
  actualProfit90d  Float?
  accuracy30d      Float?  // actual / predicted × 100 (filled 30d later)
  accuracy90d      Float?  // filled 90d later
  createdAt       DateTime @default(now())

  @@unique([date])
  @@index([date])
}

// v8.38: Notification Center — centralizirana zgodovina vseh obvestil (Brain, auto-pilot, anomalies, system).
// SPLOŠEN model (ne vezan na Monitor/Listing kot obstoječi Alert) — zato lahko beleži:
//   - Brain digeste (sendBrainDigest)
//   - Auto-pilot izvedbe (sendAutoPilotAlert)
//   - Anomalije (sendAnomalyAlert)
//   - Sistemska obvestila (manual/cron)
//   - Cene drop-e, prodaje, errors
//
// Vsa polja so Denormalized — Title + Body + Severity + Source zadostuje za prikaz v UI.
// `metadata` je JSON string z dodatnimi podatki (npr. healthScore, uplift, confidence).
// `draftId` / `snapshotDate` so optional povezave do ActionDraft / BrainSnapshot.
//
// v8.38 telegram-notifications.ts kliče createNotification() poleg sendTelegramMessage() —
// če Telegram ni konfiguriran, je obvestilo VSE ENO zabeleženo tukaj (centralni pregled).
model Notification {
  id          String   @id @default(cuid())
  type        String   // 'brain_digest' | 'autopilot_executed' | 'autopilot_rollback' | 'anomaly' | 'price_drop' | 'system' | 'trade_sold' | 'error'
  title       String   // kratek naslov (npr. "🤖 Auto-pilot izvedel akcijo")
  body        String   // dalši opis (JSON ali plain text)
  severity    String   @default("info") // 'info' | 'success' | 'warning' | 'error'
  source      String   @default("system") // 'brain' | 'autopilot' | 'telegram' | 'system' | 'manual'
  // Read tracking
  isRead      Boolean  @default(false)
  readAt      DateTime?
  // Optional links
  draftId     String?  // link to ActionDraft if autopilot
  snapshotDate String? // link to BrainSnapshot if brain_digest
  // Metadata
  metadata    String?  // JSON string z dodatnimi podatki
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
}
