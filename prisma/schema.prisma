// Prisma schema for Markec AI Firm — Opportunity Monitor

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// v4.9: Profile — switchable profiles for different scenarios (e.g., "Avto", "Nepremicnine", "Test")
// Settings has activeProfileId field; Monitor and Trade have optional profileId
// When activeProfileId is null, all data is shown (default behavior)
model Profile {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  color       String   @default("primary") // tailwind color name for badge
  icon        String   @default("📁") // emoji
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  monitors    Monitor[]
  trades      Trade[]
  settings    Settings?
}

// Single-row table storing app configuration (AI provider, Telegram, etc.)
model Settings {
  id              String   @id @default("singleton")
  // AI provider config
  aiProvider      String   @default("ollama") // ollama | openai | anthropic | openai-compatible | openrouter | gemini
  aiBaseUrl       String   @default("http://localhost:11434")
  aiApiKey        String   @default("")
  aiModel         String   @default("qwen2.5:7b")
  // v2.6: AI fallback — when primary provider fails, use fallback
  fallbackProvider String  @default("") // empty = disabled
  fallbackBaseUrl  String  @default("")
  fallbackApiKey   String  @default("")
  fallbackModel    String  @default("")
  // Telegram config
  telegramBotToken String  @default("")
  telegramChatId   String  @default("")
  telegramEnabled  Boolean @default(false)
  // v1.4: Discord webhook
  discordWebhookUrl String @default("")
  discordEnabled   Boolean @default(false)
  // v2.1: Slack webhook
  slackWebhookUrl  String  @default("")
  slackEnabled     Boolean  @default(false)
  // v2.7: Email notifications (SMTP)
  emailEnabled     Boolean  @default(false)
  emailSmtpHost    String  @default("")
  emailSmtpPort    Int     @default(587)
  emailSmtpUser    String  @default("")
  emailSmtpPassword String  @default("")
  emailFrom        String  @default("")
  emailTo          String  @default("")
  // Heartbeat
  heartbeatEnabled Boolean @default(true)
  heartbeatHour    Int     @default(22) // 22:00 local
  lastHeartbeatAt  DateTime?
  // Thresholds
  minOpportunityScore Int  @default(7)   // 1-10 — alert only when AI score >= this
  maxRiskScore        Int  @default(3)   // 1-10 — alert only when AI risk <= this
  // v8.24: User Risk Profile — makes Master Brain personal
  userRiskTolerance     String   @default("balanced") // 'conservative' | 'balanced' | 'aggressive'
  userMaxAcceptableRisk Int      @default(50) // 0-100 — max risk score user will accept
  userLiquidityReserve  Float    @default(500) // EUR — minimum cash reserve to keep
  userInvestmentHorizon String   @default("medium") // 'short' | 'medium' | 'long'
  // Image analysis (v1.1)
  imageAnalysisEnabled Boolean @default(false)
  // Bolha Playwright fallback (v1.1)
  playwrightEnabled    Boolean @default(false)
  // Telegram inline buttons (v1.1)
  telegramInlineButtons Boolean @default(true)
  // Webhook secret for Telegram callback queries (v1.1)
  telegramWebhookSecret String @default("")
  // v1.5: Web Push notifications (VAPID)
  pushEnabled          Boolean @default(false)
  vapidPublicKey       String  @default("")
  vapidPrivateKey      String  @default("")
  // v1.6: Digest mode (namesto instant alerts)
  digestMode           String  @default("instant") // instant | daily | weekly
  digestHour           Int     @default(20) // 20:00 local
  // v1.6: Quick response templates (JSON array of {name, text} objects)
  quickResponseTemplates String @default("[]")
  // v2.2: Notification quiet hours — don't send alerts during these hours
  quietHoursEnabled    Boolean @default(false)
  quietStartHour       Int     @default(22) // 22:00
  quietEndHour         Int     @default(7)  // 07:00
  // v2.2: Auto-cleanup — automatically archive/delete old data
  autoCleanupEnabled   Boolean @default(false)
  autoCleanupAlertsDays Int    @default(30) // archive alerts older than N days
  autoCleanupListingsDays Int  @default(90) // delete listings older than N days
  // v3.2: AI usage tracking
  aiCallsToday         Int    @default(0)
  aiCallsDate          String @default("") // YYYY-MM-DD for daily reset
  // v4.2: Profit goal tracking
  monthlyProfitGoal    Float  @default(0)  // EUR per month, 0 = disabled
  // v5.5: Category-based notification preferences (JSON: { "avto": {telegram: false, push: true}, ... })
  categoryNotifications String @default("{}")
  // v5.6: Dashboard widget layout (JSON array of widget IDs in display order)
  dashboardLayout      String @default("[]")
  // v5.8: Advanced scraping config
  // Proxy: JSON array of { url, username?, password?, type: 'http'|'socks5' }
  proxyList            String @default("[]")
  proxyEnabled         Boolean @default(false)
  // Realistic headers: rotate User-Agent strings
  realisticHeaders     Boolean @default(true)
  // Request randomization: random delay between requests (ms)
  requestMinDelay      Int    @default(1000) // min delay between requests
  requestMaxDelay      Int    @default(5000) // max delay
  // Stealth mode: use Playwright with anti-detection
  stealthMode          Boolean @default(false)
  // CAPTCHA solving: 2captcha API key
  captchaSolverEnabled Boolean @default(false)
  captchaApiKey        String @default("") // primary provider key
  // v5.9: Multi-provider CAPTCHA support
  captchaProvider      String @default("2captcha") // 2captcha | anti-captcha | capmonster | custom
  captchaApiKeyAnticaptcha String @default("")
  captchaApiKeyCapmonster  String @default("")
  captchaCustomApiUrl      String @default("") // for custom provider
  // TLS fingerprinting: use custom TLS client
  tlsFingerprinting    Boolean @default(false)
  // v4.9: Active profile (null = show all data, no profile filter)
  activeProfileId      String? @unique
  activeProfile        Profile? @relation(fields: [activeProfileId], references: [id], onDelete: SetNull)
  // v6.1: Email digest template (HTML template with {{title}}, {{listings}}, etc.)
  emailDigestTemplate  String @default("")
  // v8.28: Adaptive Domain Weights — JSON storing per-domain weight + execution stats.
  // Format: {"profit":{"weight":1.2,"executed":0,"rejected":0,"lastAdjustedAt":null,"adjustmentHistory":[]},...}
  // When null, Master Brain uses DEFAULT_DOMAIN_WEIGHTS (hardcoded in master.ts).
  // Updated by recordActionFeedback() after every user "executed"/"rejected" mark.
  // Re-evaluated every 10 actions per domain: executionRate > 0.8 → ×1.1 (boost),
  // < 0.4 → ×0.9 (reduce), clamp [0.5, 2.0]. Stored per-user (singleton row).
  adaptiveDomainWeights String?
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// v6.1: Saved Searches — uporabnik shrani kompleksne iskalne filtrore
model SavedSearch {
  id          String   @id @default(cuid())
  name        String
  // JSON: { monitorId, verdict, minScore, maxRisk, hasImage, bookmarkedOnly, contactFilter, sort, keywords }
  filters     String
  // Optional: auto-run and notify when new results
  autoNotify  Boolean  @default(false)
  lastRunAt   DateTime?
  lastResultCount Int  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// v1.5: Push subscription — stores browser push endpoints
model PushSubscription {
  id          String   @id @default(cuid())
  endpoint    String   @unique // browser push endpoint URL
  p256dh      String   // user agent public key
  auth        String   // auth secret
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// v1.6: Trade — tracks bought + sold listings for profit calculation
model Trade {
  id          String   @id @default(cuid())
  // v4.9: Profile assignment (null = no profile / visible in all)
  profileId   String?
  profile     Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  // Link to original listing (nullable if user manually adds)
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // Item details (denormalized so manual trades work without listing)
  title       String
  category    String   @default("") // npr. "elektronika", "avto", "nepremičnina"
  imageUrl    String?
  url         String?
  // Buy side
  buyPrice    Float    // EUR
  buyDate     DateTime @default(now())
  buyLocation String   @default("") // kje kupljeno (Bolha, FB, trgovina)
  buyFees     Float    @default(0) // pristojbine, šhiping pri nakupu
  // Sell side (null if not yet sold)
  sellPrice   Float?
  sellDate    DateTime?
  sellLocation String  @default("") // kje prodano
  sellFees    Float    @default(0) // pristojbine pri prodaji
  // Status
  status      String   @default("held") // held | sold | cancelled
  // Notes
  notes       String   @default("")
  // v7.35: Flip Workflow checklist — JSON array of {step, completedAt}
  // Steps: received, cleaned, photographed, described, listed_bolha, listed_vinted, listed_other, price_review_7d, price_drop_14d, price_drop_30d
  flipChecklist String @default("[]")
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, buyDate])
  @@index([category])
  // v7.32: Missing indexes for common queries
  @@index([sellDate])
  @@index([sellLocation])
  @@index([profileId])
}

// v1.6: Digest log — when digests were sent (for scheduling)
model DigestLog {
  id          String   @id @default(cuid())
  sentAt      DateTime @default(now())
  type        String   // daily | weekly
  listingsCount Int    @default(0)
  alertsCount Int      @default(0)
  topOpportunities Int @default(0)
  sentTelegram Boolean @default(false)
  sentDiscord  Boolean @default(false)
  sentPush     Boolean @default(false)
  message     String
}

// A configured search monitor (e.g. "iPhone 13 Pro on Bolha", "2-sobno LJ na Nepremicnine")
model Monitor {
  id          String   @id @default(cuid())
  name        String
  source      String   // bolha | nepremicnine | avtonet | salomon | custom-rss | vinted | mobile-de | kleinanzeigen | subito | willhaben
  sourceUrl   String   // the search URL or RSS URL
  // v4.9: Profile assignment (null = no profile / visible in all)
  profileId   String?
  profile     Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  // Optional filters
  keywords    String   @default("") // comma-separated, must appear in title/description
  excludeKeywords String @default("")
  minPrice    Int?
  maxPrice    Int?
  // Schedule
  intervalMinutes Int @default(30)
  isActive   Boolean  @default(true)
  // v1.2: schedule window — only run during these hours (e.g. "6-23"). Empty = always.
  runStartHour Int?
  runEndHour   Int?
  lastRunAt  DateTime?
  lastStatus String?  // ok | error | empty
  lastError  String?
  // v1.3: auto-pause after N consecutive errors
  consecutiveErrors Int @default(0)
  autoPauseThreshold Int @default(5)  // 0 = disabled, otherwise pause after N consecutive errors
  autoPausedAt DateTime?
  // v2.2: Monitor-specific notification channels (JSON: {telegram, discord, slack, push})
  notificationChannels String @default("{}") // empty = use global settings
  // AI prompt customization (optional)
  customPrompt String @default("")
  // v4.4: Tags for grouping/filtering (comma-separated, e.g. "avto,ljubljana,investicija")
  tags String @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listings   Listing[]
  alerts     Alert[]
  runLogs    RunLog[]
  // v7.32: Missing indexes
  @@index([isActive])
  @@index([profileId])
}

// A scraped listing — kept for deduplication & history
model Listing {
  id          String   @id @default(cuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  externalId  String   // unique listing id from source (URL hash)
  title       String
  price       Int?     // EUR
  priceText   String   // raw price text (e.g. "Po dogovoru")
  url         String
  location    String   @default("")
  description String   @default("")
  imageUrl    String?
  postedAt    DateTime?
  firstSeenAt DateTime @default(now())
  // AI evaluation (cached)
  aiScore        Int?      // 1-10 opportunity score
  aiRisk         Int?      // 1-10 risk score
  aiVerdict      String?   // PRILIKA | SUMNJIVO | NEZANIMIVO
  aiReason       String?
  aiEstimatedValue Int?    // EUR — what AI thinks fair market value is
  aiEvaluatedAt  DateTime?
  // Image analysis (v1.1)
  aiImageAnalysis String?  // AI description of the listing image
  aiImageVerdict  String?  // AUTHENTIC | SUSPICIOUS | STOCK_PHOTO | NO_IMAGE
  // v2.4: bookmark/favorite
  isBookmarked    Boolean  @default(false)
  bookmarkedAt    DateTime?
  // v4.1: Hidden (hide without delete)
  isHidden        Boolean  @default(false)
  hiddenAt        DateTime?
  // v1.4: full detail page data (Bolha detail page scraper)
  detailDescription String? // full description from detail page (longer than listing description)
  detailImages      String? // JSON array of all image URLs
  detailFetchedAt   DateTime?
  // v2.0: seller tracking (extracted from listing URL or description)
  sellerName       String?
  sellerListingCount Int   @default(0) // how many listings this seller has
  // v2.0: price drop tracking
  previousPrice    Int?    // last known price before current (for drop detection)
  priceDroppedAt   DateTime? // when the price last dropped
  // v2.4: Personal notes (user's own notes about this listing)
  userNotes        String?
  userNotesUpdatedAt DateTime?
  // v2.4: Contact tracking
  contactStatus    String   @default("none") // none | contacted | responded | closed
  contactedAt      DateTime?
  sellerResponse   String?
  // v4.4: AI Deal Score 0-100 (separate from aiScore 1-10)
  dealScore        Int?     // 0-100, higher = better deal
  dealScoreReason  String?  // short AI explanation
  dealScoreComputedAt DateTime?
  // v4.5: User-defined target price — alert me when price drops at or below this
  targetPrice      Int?     // EUR — alert when price <= this
  targetPriceSetAt DateTime?
  targetPriceAlertSent Boolean @default(false) // prevent alert spam
  // Alerts generated for this listing
  alerts      Alert[]
  priceHistory PriceHistory[]
  // v1.6: Trade (if this listing was bought)
  trades      Trade[]
  // v5.4: Negotiation messages with seller
  negotiationMessages NegotiationMessage[]

  @@unique([monitorId, externalId])
  @@index([monitorId, firstSeenAt])
  @@index([aiVerdict, aiScore])
  @@index([isBookmarked, firstSeenAt])
  @@index([isHidden, firstSeenAt])
  @@index([price])
  @@index([sellerName])
  // v7.32: Missing indexes
  @@index([contactStatus])
  @@index([dealScore])
  @@index([targetPrice])
  @@index([priceDroppedAt])
}

// An alert that was sent (Telegram/email/dashboard)
model Alert {
  id          String   @id @default(cuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  title       String
  body        String
  url         String
  aiScore     Int?
  aiRisk      Int?
  aiVerdict   String?
  // Delivery
  sentTelegram Boolean @default(false)
  telegramSentAt DateTime?
  telegramError String?
  // v2.9: Notification delivery tracking
  sentDiscord   Boolean @default(false)
  discordError  String?
  sentSlack     Boolean @default(false)
  slackError    String?
  sentEmail     Boolean @default(false)
  emailError    String?
  sentPush      Boolean @default(false)
  pushError     String?
  // UI state
  isRead      Boolean  @default(false)
  isArchived  Boolean  @default(false)
  // v1.2: user feedback for AI accuracy tracking
  userAction  String?  // interested | archived | scam | ignored (auto-set after 7 days)
  userActionedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([monitorId, createdAt])
  @@index([isArchived, createdAt])
  @@index([userAction])
  // v7.32: Missing indexes
  @@index([isRead, createdAt])
  @@index([aiVerdict])
}

// Run log — every monitor execution record
model RunLog {
  id          String   @id @default(cuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  status      String   // ok | error | empty
  listingsFound Int    @default(0)
  newListings  Int     @default(0)
  alertsSent   Int     @default(0)
  error       String?
  durationMs  Int?

  @@index([monitorId, startedAt])
  // v7.32: Missing index
  @@index([status])
}

// Heartbeat log — daily system health report (v1.1)
model HeartbeatLog {
  id            String   @id @default(cuid())
  sentAt        DateTime @default(now())
  periodStart   DateTime
  periodEnd     DateTime
  totalRuns     Int      @default(0)
  successfulRuns Int     @default(0)
  failedRuns    Int      @default(0)
  totalListings Int      @default(0)
  newListings   Int      @default(0)
  totalAlerts   Int      @default(0)
  prilikaAlerts Int      @default(0)
  sumnjivoAlerts Int     @default(0)
  activeMonitors Int     @default(0)
  sentTelegram  Boolean  @default(false)
  telegramError String?
  message       String
}

// v1.4: Price history — tracks price changes of a listing over time
model PriceHistory {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price       Int?     // EUR — null if "po dogovoru"
  priceText   String   // raw text
  seenAt      DateTime @default(now())

  @@index([listingId, seenAt])
}

// v5.3: Smart Rules — kompleksna pravila za alerte (npr. "alert ko 3 podobni oglasi padejo pod X€")
model SmartRule {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  // Rule type: 'price_threshold' | 'multiple_listings' | 'price_drop_pct' | 'ai_verdict_combo' | 'time_based'
  ruleType    String
  // JSON configuration for the rule (depends on ruleType)
  // price_threshold: { monitorId, priceBelow, minDealScore? }
  // multiple_listings: { monitorId, count, withinHours, priceBelow? }
  // price_drop_pct: { monitorId, dropPct, withinHours }
  // ai_verdict_combo: { monitorId, minAiScore, maxAiRisk, minDealScore? }
  // time_based: { monitorId, hoursOld, priceBelow? }
  config      String   // JSON
  // Channels (JSON array: ['telegram', 'discord', 'slack', 'push', 'email'])
  channels    String   @default("[]")
  isActive    Boolean  @default(true)
  // Tracking
  lastTriggeredAt DateTime?
  triggerCount Int     @default(0)
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// v5.4: Negotiation messages — sledi pogajanjem z vsakim prodajalcem
model NegotiationMessage {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Message direction: 'sent' (from user to seller) | 'received' (from seller to user)
  direction   String
  // Message content
  text        String
  // AI generated?
  isAiGenerated Boolean @default(false)
  // AI suggested next step (filled when message is sent)
  aiNextStep  String?
  // Negotiation status: 'initial' | 'offer_sent' | 'counter_received' | 'accepted' | 'declined' | 'no_response'
  status      String   @default("initial")
  // Suggested price in this message (if applicable)
  suggestedPrice Int?
  // Metadata
  createdAt   DateTime @default(now())

  @@index([listingId, createdAt])
}

// v5.4: Webhook endpoints — zunanji servisi (Zapier, Make) prejemajo alerte
model WebhookEndpoint {
  id          String   @id @default(cuid())
  name        String
  url         String
  // Secret for HMAC signature verification
  secret      String   @default("")
  // Events to subscribe to (JSON array: ['alert.created', 'price.drop', 'target.hit', 'listing.new'])
  events      String   @default("[]")
  // Active?
  isActive    Boolean  @default(true)
  // Tracking
  lastTriggeredAt DateTime?
  lastResponseStatus Int?
  lastError   String?
  triggerCount Int     @default(0)
  failCount   Int      @default(0)
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// v8.23: Daily Brain Snapshot — stores Master Brain output for historical accuracy tracking.
// Cron job @ 00:00 calls masterBrain() and saves the full result here.
// Used by v8.25 (Historical Accuracy) to compare predicted vs actual profit.
model BrainSnapshot {
  id              String   @id @default(cuid())
  date            String   // YYYY-MM-DD (unique per day)
  // Overall Master Brain summary (lightweight fields for quick queries)
  overallHealth   Float    // 0-100
  healthGrade     String   @default("C") // 'A+'|'A'|'B'|'C'|'D'|'F'
  riskLevel       String   @default("MEDIUM") // 'LOW'|'MEDIUM'|'HIGH'|'CRITICAL'
  topActionCount  Int      @default(5)
  conflictCount   Int      @default(0)
  bottleneckCount Int      @default(0)
  strengthCount   Int      @default(0)
  // Strategy projections (EUR)
  projection30dEUR  Float  @default(0)
  projection90dEUR  Float  @default(0)
  projection12mEUR  Float  @default(0)
  // 7 Domain grades (for trend analysis)
  profitGrade     String   @default("C")
  inventoryGrade  String   @default("C")
  marketGrade     String   @default("C")
  sourcingGrade   String   @default("C")
  riskGrade       String   @default("C")
  buyerGrade      String   @default("C")
  pricingGrade    String   @default("C")
  // Full Master Brain JSON (for deep drill-down)
  masterResultJson String  // full JSON.stringify(masterResult)
  // Actual profit at time of snapshot (filled by v8.25 backfill, null at creation)
  actualProfit30d  Float?
  actualProfit90d  Float?
  accuracy30d      Float?  // actual / predicted × 100 (filled 30d later)
  accuracy90d      Float?  // filled 90d later
  createdAt       DateTime @default(now())

  @@unique([date])
  @@index([date])
}
